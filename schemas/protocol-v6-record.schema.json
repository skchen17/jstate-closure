{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/jclosure/protocol-v6-record.schema.json",
  "title": "J-state peripheral foundations protocol v6 record",
  "type": "object",
  "required": ["schema_version", "protocol_version", "record_type", "run_id"],
  "properties": {
    "schema_version": {"const": 8},
    "protocol_version": {"const": "peripheral_foundations_protocol_v6"},
    "record_type": {"type": "string"},
    "run_id": {"type": "string"},
    "valid": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
