.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Model, lens, activation, and training artifacts are intentionally external.
artifacts/models/
artifacts/lenses/
artifacts/offload/
artifacts/checkpoints/
artifacts/traces/
*.pt
*.pth
*.safetensors
*.npz
*.npy

# Oversize local calibration material is represented in Git by hashed,
# publication-safe partitioned Parquet records and run manifests.
results/v3_1/raw/calibration-v3-1-*/calibration-shard-*.parquet
results/v3_1/processed/closure_v3_1_calibration.parquet

# Machine-readable metrics and generated figures are intentionally versioned.
# Large tensors/checkpoints remain excluded by the extension rules above.

# Local run state and credentials must never be committed.
.env
.env.*
!.env.example
run-state/
offload/
