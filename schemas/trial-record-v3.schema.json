{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skchen17/jstate-closure/schemas/trial-record-v3.schema.json",
  "title": "Exploratory protocol v3 trial record",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "run_id",
    "paired_trial_id",
    "task_family",
    "state_definition",
    "dictionary_size",
    "layer",
    "position_scope",
    "valid",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "protocol_version": {"const": "exploratory_protocol_v3"},
    "run_id": {"type": "string", "minLength": 1},
    "paired_trial_id": {"type": "string", "minLength": 1},
    "task_family": {"type": "string", "minLength": 1},
    "state_definition": {"enum": ["V3-Dense", "V3-Sparse"]},
    "dictionary_size": {"enum": [4096, 8192, 16384]},
    "dictionary_hash": {"type": "string"},
    "layer": {"type": "integer"},
    "position_scope": {
      "enum": ["final", "explicit", "all_non_padding", "reasoning_span"]
    },
    "clamp_mode": {
      "enum": ["single", "persistent_final", "persistent_all"]
    },
    "hook_schedule": {"type": "object"},
    "valid": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "metrics": {"type": "object"}
  },
  "additionalProperties": true
}
