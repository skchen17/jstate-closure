{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jstate-closure.local/schemas/protocol-v13-record.schema.json",
  "title": "J-state closure protocol V13 record",
  "type": "object",
  "required": ["schema_version", "protocol_version"],
  "properties": {
    "schema_version": {"const": 22},
    "protocol_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "base_trial_id": {"type": "string"},
    "family": {"type": "string"},
    "split": {"type": "string"}
  },
  "additionalProperties": true
}
